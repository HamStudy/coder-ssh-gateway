# coder-ssh-gateway systemd unit.
#
# Install:
#   install -m 0644 coder-ssh-gateway.service /etc/systemd/system/
#   systemctl daemon-reload
#   systemctl enable --now coder-ssh-gateway
#
# Prerequisites:
#   - dedicated system user and group:
#       useradd --system --home /var/lib/coder-ssh-gateway \
#         --shell /usr/sbin/nologin coder-ssh-gateway
#   - state dir initialized as the service user (the secrets and
#     lock must already be owned by coder-ssh-gateway on first start;
#     running init as root and chown-ing afterward leaves intermediate
#     records at the wrong ownership, which `doctor` will flag):
#       sudo install -d -o coder-ssh-gateway -g coder-ssh-gateway -m 0700 \
#         /var/lib/coder-ssh-gateway
#       sudo -u coder-ssh-gateway -g coder-ssh-gateway \
#         coder-ssh-gateway --state-dir /var/lib/coder-ssh-gateway init coder.example.com
#   - Coder CLI installed at /usr/local/bin/coder (pin the version; see
#     deployment.coder_binary in config.yaml)
#
# --state-dir is a GLOBAL flag and must come BEFORE the subcommand.
[Unit]
Description=Coder SSH Gateway
Documentation=https://github.com/taxilian/coder-ssh-gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=coder-ssh-gateway
Group=coder-ssh-gateway
ExecStart=/usr/local/bin/coder-ssh-gateway --state-dir /var/lib/coder-ssh-gateway serve
Restart=on-failure
RestartSec=2

# Hardening: a deliberate sandbox for the gateway. If the Coder CLI
# cannot reach workspaces (DERP relays, direct UDP paths, proxies),
# suspect the sandbox first and relax the minimum set of options below;
# verify connectivity before production rollout.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true

ReadWritePaths=/var/lib/coder-ssh-gateway
# Optional: mount secrets (host key, encryption key) outside the state dir
# read-only instead of keeping them under /var/lib/coder-ssh-gateway/secrets.
ReadOnlyPaths=/run/secrets

LimitNOFILE=65536
TasksMax=1024

# Disable core dumps: tokens live in process memory; a core dump is a
# credential.
LimitCORE=0

[Install]
WantedBy=multi-user.target
